# ---------------------------------------------------------------------------
# Pulse -- copy to .env and fill in. Never commit the filled-in file.
# ---------------------------------------------------------------------------

# --- Application -----------------------------------------------------------
ENVIRONMENT=local                 # local | staging | production
DEBUG=false
LOG_LEVEL=INFO
LOG_JSON=true

# Public URL the Mini App is served from. Must be https for Telegram to open it.
PUBLIC_WEB_URL=https://pulse.mammad.site
CORS_ORIGINS=https://pulse.mammad.site,https://web.telegram.org

# --- Security --------------------------------------------------------------
# Generate with: python -c "import secrets; print(secrets.token_urlsafe(48))"
SECRET_KEY=change-me-to-a-long-random-string-at-least-32-chars
ACCESS_TOKEN_TTL_MINUTES=60
REFRESH_TOKEN_TTL_DAYS=30
TELEGRAM_INITDATA_MAX_AGE_SECONDS=86400

# --- Telegram --------------------------------------------------------------
TELEGRAM_BOT_TOKEN=000000000:replace-with-your-bot-token
TELEGRAM_BOT_USERNAME=YourBot
# Bypasses signature checks. Local development only -- never set in production.
ALLOW_DEV_LOGIN=false

# --- Database --------------------------------------------------------------
POSTGRES_HOST=db
POSTGRES_PORT=5432
POSTGRES_USER=pulse
POSTGRES_PASSWORD=change-me
POSTGRES_DB=pulse
# Host port the database is published on (localhost only).
DB_PORT=5434

# --- Redis -----------------------------------------------------------------
REDIS_URL=redis://redis:6379/0

# --- Serving ---------------------------------------------------------------
# Host port nginx binds to (localhost only; the Cloudflare Tunnel reaches it).
WEB_PORT=8094
NEXT_PUBLIC_API_BASE_URL=/api/v1

# --- Automated accounts ----------------------------------------------------
# Off by default: nothing generates, and nothing is billed, until this is on.
AI_ENABLED=false
# Generation is charged to this key. Keep it out of the repository.
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4.1-mini
OPENAI_BASE_URL=https://api.openai.com/v1

# How often the worker looks for accounts that are due to act.
AI_TICK_SECONDS=60
# Ceilings: the first bounds any single account, the second bounds the bill.
AI_MAX_POSTS_PER_ACCOUNT_PER_DAY=12
AI_MAX_GENERATIONS_PER_DAY=600
AI_TIMELINE_LOOKBACK_HOURS=48
